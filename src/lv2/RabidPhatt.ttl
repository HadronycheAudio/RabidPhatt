@prefix atom:  <http://lv2plug.in/ns/ext/atom#> .
@prefix bufsz: <http://lv2plug.in/ns/ext/buf-size#> .
@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix midi:  <http://lv2plug.in/ns/ext/midi#> .
@prefix opts:  <http://lv2plug.in/ns/ext/options#> .
@prefix pprop: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix urid:  <http://lv2plug.in/ns/ext/urid#> .

# Port indices and symbols are saved in hosts' projects. Controls follow ParamId in src/Parameters.h, in the same
# order, and new ones only go at the end.
#
# LV2 has no curve for LFO delay's Curve::Squared, so a host's own slider for it is linear, unlike the panel's knob.

<https://github.com/HadronycheAudio/RabidPhatt>
    a lv2:Plugin , lv2:InstrumentPlugin , doap:Project ;
    doap:name "RabidPhatt" ;
    doap:license <https://opensource.org/licenses/MIT> ;
    doap:maintainer [ foaf:name "Hadronyche" ] ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map , opts:options , bufsz:boundedBlockLength ;
    lv2:optionalFeature lv2:hardRTCapable ;
    opts:requiredOption bufsz:maxBlockLength ;
    lv2:port [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "out_left" ;
        lv2:name "Left" ;
    ] , [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_right" ;
        lv2:name "Right" ;
    ] , [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:designation lv2:control ;
        lv2:index 2 ;
        lv2:symbol "events" ;
        lv2:name "MIDI In" ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "motion" ;
        lv2:name "Motion" ;
        lv2:minimum 0.001 ;
        lv2:maximum 1.0 ;
        lv2:default 0.25 ;
        lv2:portProperty pprop:logarithmic ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "glide" ;
        lv2:name "Glide" ;
        lv2:minimum 1.0 ;
        lv2:maximum 5000.0 ;
        lv2:default 1.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "amp_attack" ;
        lv2:name "Amp attack" ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:default 5.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "amp_decay" ;
        lv2:name "Amp decay" ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:default 300.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "amp_sustain" ;
        lv2:name "Amp sustain" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 80.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "amp_release" ;
        lv2:name "Amp release" ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:default 200.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "filter_cutoff" ;
        lv2:name "Filter cutoff" ;
        lv2:minimum 20.0 ;
        lv2:maximum 20000.0 ;
        lv2:default 1000.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:hz ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "filter_resonance" ;
        lv2:name "Filter resonance" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 20.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "filter_env_amount" ;
        lv2:name "Filter env amount" ;
        lv2:minimum -8.0 ;
        lv2:maximum 8.0 ;
        lv2:default 3.0 ;
        units:unit units:oct ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "filter_attack" ;
        lv2:name "Filter attack" ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:default 5.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "filter_decay" ;
        lv2:name "Filter decay" ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:default 400.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "filter_sustain" ;
        lv2:name "Filter sustain" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 30.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "filter_release" ;
        lv2:name "Filter release" ;
        lv2:minimum 1.0 ;
        lv2:maximum 10000.0 ;
        lv2:default 300.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:ms ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ;
        lv2:symbol "volume" ;
        lv2:name "Volume" ;
        lv2:minimum -60.0 ;
        lv2:maximum 6.0 ;
        lv2:default 0.0 ;
        lv2:scalePoint [ rdfs:label "-inf" ; rdf:value -60.0 ] ;
        units:unit units:db ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ;
        lv2:symbol "lfo_rate" ;
        lv2:name "LFO rate" ;
        lv2:minimum 0.05 ;
        lv2:maximum 20.0 ;
        lv2:default 1.0 ;
        lv2:portProperty pprop:logarithmic ;
        units:unit units:hz ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ;
        lv2:symbol "lfo_amount" ;
        lv2:name "LFO amount" ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        lv2:default 0.0 ;
        units:unit units:pc ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 19 ;
        lv2:symbol "lfo_delay" ;
        lv2:name "LFO delay" ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
        lv2:default 0.0 ;
        units:unit units:s ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 20 ;
        lv2:symbol "lfo_sync" ;
        lv2:name "LFO sync" ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:default 0 ;
        lv2:portProperty lv2:toggled ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 21 ;
        lv2:symbol "lfo_division" ;
        lv2:name "LFO division" ;
        lv2:minimum 0 ;
        lv2:maximum 15 ;
        lv2:default 7 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint
            [ rdfs:label "4/1" ; rdf:value 0 ] ,
            [ rdfs:label "2/1" ; rdf:value 1 ] ,
            [ rdfs:label "1/1" ; rdf:value 2 ] ,
            [ rdfs:label "1/2 dotted" ; rdf:value 3 ] ,
            [ rdfs:label "1/2" ; rdf:value 4 ] ,
            [ rdfs:label "1/2 triplet" ; rdf:value 5 ] ,
            [ rdfs:label "1/4 dotted" ; rdf:value 6 ] ,
            [ rdfs:label "1/4" ; rdf:value 7 ] ,
            [ rdfs:label "1/4 triplet" ; rdf:value 8 ] ,
            [ rdfs:label "1/8 dotted" ; rdf:value 9 ] ,
            [ rdfs:label "1/8" ; rdf:value 10 ] ,
            [ rdfs:label "1/8 triplet" ; rdf:value 11 ] ,
            [ rdfs:label "1/16 dotted" ; rdf:value 12 ] ,
            [ rdfs:label "1/16" ; rdf:value 13 ] ,
            [ rdfs:label "1/16 triplet" ; rdf:value 14 ] ,
            [ rdfs:label "1/32" ; rdf:value 15 ] ;
    ] .
